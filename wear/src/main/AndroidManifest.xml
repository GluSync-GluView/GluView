<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Watch Face Push (plano 16) pede minSdk 33 e wear-sdk OBRIGATÓRIO; aqui os dois viram
         opcionais (o app continua instalando no Wear OS 3/4) e o código só usa o Push quando
         WatchFacePushManagerFactory.isSupported() (ver watchface/FacePusher). -->
    <uses-sdk tools:overrideLibrary="androidx.wear.watchfacepush" />
    <!-- Achado do W0: sem esta permissão o sistema recusa a conexão com o serviço do Push. -->
    <uses-permission android:name="com.google.wear.permission.PUSH_WATCH_FACES" />
    <uses-permission android:name="com.google.wear.permission.SET_PUSHED_WATCH_FACE_AS_ACTIVE" />

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Plano 21, F7.1: alertas do celular vibram no padrão escolhido e aparecem como notificação. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GluViewWearApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_gluview"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="wear-sdk"
            android:required="false"
            tools:replace="android:required" />

        <!-- Precisa do celular para receber leitura e token (não é standalone). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fase 5: leitura (DataItem) e token (mensagem) vindos do celular. -->
        <service
            android:name=".data.PhoneListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:host="*" android:pathPrefix="/gluview/reading" android:scheme="wear" />
                <data android:host="*" android:pathPrefix="/gluview/watchface" android:scheme="wear" />
                <data android:host="*" android:pathPrefix="/gluview/day" android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:host="*" android:pathPrefix="/gluview/token" android:scheme="wear" />
                <data android:host="*" android:pathPrefix="/gluview/diary/ack" android:scheme="wear" />
                <data android:host="*" android:pathPrefix="/gluview/alert" android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Fase 6: complication (funciona em qualquer mostrador) e tile. -->
        <service
            android:name=".complication.GlucoseComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_gluview"
            android:label="@string/complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE,SMALL_IMAGE" />
            <!-- A cada 5 min recalcula a idade: sem leitura nova, o valor vira tracinhos sozinho. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- Componentes do visor que faltavam no Wear OS (14/11/2026): idade da leitura, alertas,
             sensor e bateria do celular — também servem em qualquer mostrador. -->
        <service
            android:name=".complication.ReadingAgeComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_gluview"
            android:label="@string/info_reading_age"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <service
            android:name=".complication.LowAlertComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_gluview"
            android:label="@string/info_low_alert"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <service
            android:name=".complication.HighAlertComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_gluview"
            android:label="@string/info_high_alert"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <service
            android:name=".complication.SensorComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_gluview"
            android:label="@string/info_sensor"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>

        <service
            android:name=".complication.PhoneBatteryComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_gluview"
            android:label="@string/info_phone_battery"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>

        <!-- Plano 17, Fase 4: próximo lembrete do GluView em qualquer mostrador. -->
        <service
            android:name=".complication.NextReminderComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_gluview"
            android:label="@string/next_reminder"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>

        <!-- Plano 17, Fase 4: registrar no diário pelo relógio. -->
        <!-- Exportada porque o atalho do tile é aberto pelo sistema (fora do app); a pessoa
             sempre confirma antes de registrar. -->
        <activity
            android:name=".LogActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <service
            android:name=".tile.GlucoseTileService"
            android:exported="true"
            android:icon="@drawable/ic_gluview"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>
    </application>
</manifest>
