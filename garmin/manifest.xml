        entry="GluViewApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.2.0">
        <iq:products>
            <iq:product id="venu3"/>
            <iq:product id="venu3s"/>
            <iq:product id="vivoactive5"/>
            <iq:product id="fenix7"/>
            <iq:product id="fr965"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>por</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
