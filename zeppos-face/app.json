{
  "configVersion": "v3",
  "app": {
    "appId": 1100922,
    "appName": "GluView Visor",
    "appType": "watchface",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "gluview",
    "description": "Mostrador do GluView: glicemia e gráfico do servidor local do celular."
  },
  "permissions": ["data:os.device.info"],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "watchface": {
          "path": "watchface/index",
          "main": 1,
          "editable": 0,
          "lockscreen": 0
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        { "st": "r", "dw": 480 },
        { "st": "s", "dw": 390 }
      ]
    }
  },
  "i18n": {
    "en-US": { "appName": "GluView Visor" },
    "pt-BR": { "appName": "GluView Visor" }
  },
  "defaultLanguage": "pt-BR"
}
