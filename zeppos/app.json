{
  "configVersion": "v3",
  "app": {
    "appId": 20921,
    "appName": "GluView",
    "appType": "app",
    "version": { "code": 1, "name": "1.0.0" },
    "icon": "icon.png",
    "vender": "gluview",
    "description": "Glicemia do GluView via servidor local do celular (F7.3, Sem teste no simulador Zepp OS sem hardware)."
  },
  "permissions": ["data:os.device.info", "device:os.local_storage", "device:os.bg_service"],
  "runtime": {
    "apiVersion": { "compatible": "3.0", "target": "3.0", "minVersion": "3.0" }
  },
  "targets": {
    "common": {
      "module": {
        "page": { "pages": ["page/index"] },
        "app-side": { "path": "app-side/index" }
      },
      "platforms": [{ "st": "r" }, { "st": "s" }]
    }
  },
  "i18n": { "en-US": { "appName": "GluView" }, "pt-BR": { "appName": "GluView" } },
  "defaultLanguage": "pt-BR"
}
