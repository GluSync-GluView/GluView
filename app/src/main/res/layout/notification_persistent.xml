<?xml version="1.0" encoding="utf-8"?>
<!-- Notificação expandida (redesign visual, Fase 5): o gráfico da Home no tamanho real, fundo
     transparente sobre o cartão do sistema, e uma linha "135 ↗   +3 mg/dL · 14:05". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- adjustViewBounds=true mantém proporção do bitmap → sem distorção nos números -->
    <ImageView
        android:id="@+id/iv_graph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="@string/notif_chart_description" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_sgv_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_delta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
