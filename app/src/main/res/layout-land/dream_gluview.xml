<?xml version="1.0" encoding="utf-8"?>
<!-- Protetor de tela em paisagem: valor à esquerda, gráfico à direita (antes a coluna de
     96sp + 30sp + 18sp + 200dp passava da altura da tela e cortava). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/dream_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        android:paddingVertical="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dream_sgv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="88sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_dream_arrow_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF"
                android:textSize="28sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_dream_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#99FFFFFF"
                android:textSize="18sp"
                android:maxLines="1" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_dream_graph"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="32dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

    </LinearLayout>

</FrameLayout>
