    <string name="wearable_family_huami">Mi Band 4 to 7 and Amazfit</string>
    <string name="wearable_family_huami_hint">Uses the pairing from the Mi Band screen. The only one with \"Call\": it rings until you decline it on the wrist.</string>
    <string name="wearable_family_xiaomi">Mi Band 8 and Mi Band 9 Active</string>
    <string name="wearable_family_xiaomi_hint">Uses the new Xiaomi pairing on the Mi Band screen. Arrives as a notification and vibrates with the chosen pattern.</string>
    <string name="wearable_family_wearos">Wear OS watch</string>
    <string name="wearable_family_wearos_hint">Galaxy Watch, Pixel Watch and others with the GluView app installed on the watch.</string>
    <string name="wearable_family_garmin">Garmin</string>
    <string name="wearable_family_garmin_hint">Vibrates while the GluView app is open on the watch (it fetches data every minute).</string>
    <string name="wearable_family_zepp">Amazfit with Zepp OS</string>
    <string name="wearable_family_zepp_hint">Vibrates while the GluView app is open on the watch (it fetches data every minute).</string>

